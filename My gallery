<!DO html>
<html>
<head>
    <title>My Gallery</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            background: #f5f5f5;
        }

        h1 {
            margin: 25px;
        }

        .gallery {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 15px;
            padding: 15px;
        }

        .gallery img {
            width: 100%;
            border-radius: 10px;
        }
    </style>
</head>

<body>

<h1>My Gallery</h1>

<div class="gallery">
    <img src="file_00000001.jpg">
    <img src="file_00000002.jpg">
    <img src="file_00000003.jpg">
    <img src="file_00000004.jpg">
</div>

</body>
</html>
